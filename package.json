{
  "name": "@carrara88/n8n-nodes-couchdb",
  "version": "1.0.1",
  "description": "n8n community node for Apache CouchDB",
  "keywords": [
    "n8n-community-node-package",
    "couchdb",
    "n8n"
  ],
  "license": "MIT",
  "author": "https://github.com/carrara88",
  "repository": {
    "type": "git",
    "url": "https://github.com/carrara88/n8n-nodes-couchdb.git"
  },
  "homepage": "https://github.com/carrara88/n8n-nodes-couchdb",
  "bugs": {
    "url": "https://github.com/carrara88/n8n-nodes-couchdb/issues"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "n8n": {
    "n8nNodesApiVersion": 1,
    "nodes": [
      "dist/nodes/CouchDb/CouchDb.node.js"
    ],
    "credentials": [
      "dist/credentials/CouchDbApi.credentials.js"
    ]
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist/**",
    "README.md"
  ],
  "scripts": {
    "clean": "node -e \"require('fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "tsc && npm run copy-assets",
    "copy-assets": "node scripts/copy-assets.js",
    "prepublishOnly": "npm run build",
    "pack": "npm run build && npm pack",
    "lint": "echo \"add eslint and run lint\"",
    "test": "npm run build"
  },
  "peerDependencies": {
    "n8n-workflow": ">=1.0.0",
    "n8n-core": ">=1.0.0"
  },
  "devDependencies": {
    "@types/node": "^25.0.3",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=18"
  }
}